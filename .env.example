# ==============================================================
# DIGITAL NOMADS IN NEPAL — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to `.env` and fill in your values.
# NEVER commit sensitive production credentials or .env to Git!
# ==============================================================

# Database Connection (MySQL via Prisma)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/digitalnomadsnepal"

# NextAuth / Authentication
NEXTAUTH_URL="https://digitalnomadsinnepal.com"
NEXTAUTH_SECRET="your-32-character-secret-key-here"

# Admin Setup / Secret Token
ADMIN_SECRET="your-admin-secret-token"

# Public Site Configuration
NEXT_PUBLIC_SITE_URL="https://digitalnomadsinnepal.com"
NEXT_PUBLIC_APP_NAME="Digital Nomads in Nepal"

# Google Analytics / Tag Manager (Optional)
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Email Services (Resend / SMTP - Optional)
RESEND_API_KEY=""
EMAIL_FROM="hello@digitalnomadsinnepal.com"
